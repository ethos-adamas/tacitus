{
  "name": "tacitus-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run protocol:build",
    "dev": "vite",
    "protocol:build": "wasm-pack build ../protocol --target web --out-dir ../frontend/src/generated --release",
    "build": "npm run protocol:build && tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "npm run protocol:build && tsc -b --pretty false",
    "tauri": "tauri",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  }
}
