{
  "name": "tacitus-frontend",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "predev": "npm run protocol:build",
    "dev": "vite",
    "protocol:build": "wasm-pack build ../protocol --target web --out-dir ../frontend/src/generated --release",
    "build": "npm run protocol:build && tsc -b && vite build",
    "format": "prettier --write .oxlintrc.json .prettierrc.json package.json tsconfig*.json vite.config.ts playwright.config.ts index.html src e2e",
    "format:check": "prettier --check .oxlintrc.json .prettierrc.json package.json tsconfig*.json vite.config.ts playwright.config.ts index.html src e2e",
    "lint": "oxlint",
    "pretest": "npm run protocol:build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "npm run protocol:build && tsc -b --pretty false",
    "tauri": "tauri",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "5.3.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "lucide-react": "0.545.0",
    "radix-ui": "1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "14.3.8",
    "react-redux": "^9.3.0",
    "react-zoom-pan-pinch": "4.2.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  }
}
